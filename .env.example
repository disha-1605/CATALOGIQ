# =============================================================================
# CatalogIQ Production & Development Environment Variables
# =============================================================================

# Server Environment & Port Configuration
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Application Base URLs
# In production on Render: https://catalogiq-c4cr.onrender.com
APP_BASE_URL=https://catalogiq-c4cr.onrender.com
API_BASE_URL=https://catalogiq-c4cr.onrender.com

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./catalogiq.db

# Admin Notification Configuration
ADMIN_NOTIFICATION_EMAIL=dishasengar1june@gmail.com
EMAIL_FROM=dishasengar1june@gmail.com

# =============================================================================
# Real Email Delivery (SMTP Configuration)
# =============================================================================
# Set these in your Render Environment Variables dashboard:
# 1. SMTP_HOST=smtp.gmail.com
# 2. SMTP_PORT=587
# 3. SMTP_USERNAME=dishasengar1june@gmail.com
# 4. SMTP_PASSWORD=your_16_char_google_app_password
# 5. SMTP_USE_TLS=true
# 6. SMTP_USE_SSL=false
#
# (Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dishasengar1june@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional AI Explanation Engine (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
