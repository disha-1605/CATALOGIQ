# -----------------------------------------------------------------------------
# CatalogIQ Environment Configuration
# -----------------------------------------------------------------------------

# Database Connection (SQLite default for local/staging)
DATABASE_URL=sqlite:///./catalogiq.db

# Application Environment & Server Port
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Explanation Configuration (Optional)
# Supports Google Gemini API (GEMINI_API_KEY) or OpenAI (OPENAI_API_KEY / LLM_API_KEY).
# If left blank, CatalogIQ automatically uses its built-in deterministic fallback engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI Alternative
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1
