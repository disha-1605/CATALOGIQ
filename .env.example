# =============================================================================
# CatalogIQ Production & Development Environment Variables
# =============================================================================

# Server Environment & Port Configuration
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Application Base URLs
# In production on Render: https://catalogiq-c4cr.onrender.com
APP_BASE_URL=https://catalogiq-c4cr.onrender.com
API_BASE_URL=https://catalogiq-c4cr.onrender.com

# Database Connection (SQLite default, auto-seeded on startup)
DATABASE_URL=sqlite:///./catalogiq.db

# Admin Notification Configuration
ADMIN_NOTIFICATION_EMAIL=dishasengar1june@gmail.com
EMAIL_FROM=dishasengar1june@gmail.com

# =============================================================================
# Production Email Delivery (Google Apps Script HTTPS Relay — Render Free Plan)
# =============================================================================
# Render Free plan blocks outbound SMTP ports 25, 465, and 587.
# Email delivery runs via an HTTPS POST to a Google Apps Script Web App
# deployed under dishasengar1june@gmail.com.
#
# 1. Deploy the Google Apps Script Web App (Execute as: Me, Who has access: Anyone)
# 2. Add GOOGLE_APPS_SCRIPT_URL to your Render Environment Variables dashboard.
# 3. Add GOOGLE_APPS_SCRIPT_SECRET (matching the secret in the Apps Script).
#
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# =============================================================================
# Local Development Email Delivery (Direct SMTP Fallback)
# =============================================================================
# Direct SMTP works for local testing when ports 587/465 are not blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dishasengar1june@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional AI Explanation Engine (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


