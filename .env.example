# =============================================================================
# CatalogIQ Environment Variables Configuration
# =============================================================================

# Application & API Endpoints
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./catalogiq.db

# Admin Notification Destination
# Receives real access request notifications & approval confirmations
ADMIN_NOTIFICATION_EMAIL=dishasengar1june@gmail.com
EMAIL_FROM="CatalogIQ Access Desk <noreply@catalogiq.demo>"

# =============================================================================
# Real Email Delivery (SMTP Settings)
# =============================================================================
# To enable real email delivery to inboxes, provide your SMTP credentials below.
# If using Gmail SMTP:
#   1. Set SMTP_HOST=smtp.gmail.com
#   2. Set SMTP_PORT=587 (with SMTP_USE_TLS=true) or 465 (with SMTP_USE_SSL=true)
#   3. Set SMTP_USERNAME=your_gmail_address@gmail.com
#   4. Set SMTP_PASSWORD=your_16_char_google_app_password
#      (Note: Generate App Password at https://myaccount.google.com/apppasswords)
#
# If SMTP credentials are not configured, the backend logs emails in dev mode
# and reports honest delivery status ("Email delivery is not configured").

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional AI Explanation Engine (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
